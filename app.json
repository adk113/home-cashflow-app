{
  "expo": {
    "name": "Home CashFlow Tracker",
    "slug": "home-cashflow-app",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aditya.homecashflow"
    },
    "android": {
      "package": "com.aditya.homecashflow",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "./plugins/withAndroidSmsAndNotifications.js"
    ],
    "extra": {
      "eas": {
        "projectId": "bd4a60cd-f721-4067-a3df-0a7f37472785"
      }
    }
  }
}
